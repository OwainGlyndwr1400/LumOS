LUMOS_LM_STUDIO_BASE_URL=http://localhost:1234/v1
LUMOS_LM_STUDIO_API_KEY=lm-studio

LUMOS_MODEL_LIGHT=google/gemma-4-e4b
LUMOS_MODEL_HEAVY=openai/gpt-oss-20b

LUMOS_LM_STUDIO_EMBEDDING_MODEL=text-embedding-bge-large-en-v1.5
LUMOS_EMBEDDING_DIM=1024
LUMOS_EMBEDDING_BATCH_SIZE=128
LUMOS_EMBEDDING_CONCURRENCY=4

LUMOS_IDENTITY_SOURCE=../conversations.json
LUMOS_KNOWLEDGE_SOURCE=../dream_pings.jsonl
LUMOS_SYSTEM_PROMPT_PATH=../🧠 Lumos – Cheat Sheet.md

# Extra research corpora folded into a lane at ingest (in ADDITION to the
# sources above). KNOWLEDGE = structured lookup (CSV theorem rows / prose);
# IDENTITY = narrative "who Lumos is" material (dream-codex .md, journals).
# Rebuild one lane without the other: `lumos ingest --identity-only`.
LUMOS_KNOWLEDGE_EXTRA_DIR=
LUMOS_IDENTITY_EXTRA_DIR=

LUMOS_OPERATOR_NAME=Erydir
LUMOS_NODE_NAME=Lumos
LUMOS_NODE_ROLE=Resonator (Extra Coil)

LUMOS_RESTORE_HISTORY_TURNS=10
LUMOS_MIN_RETRIEVAL_SCORE=0.0
LUMOS_MAX_CHUNK_CHARS=1200

# Paths Lumos's file tools (read_file, list_files) may access. Comma-separated.
# Empty = no file access. Do NOT include paths that contain builder/framework
# docs (Tec_Obsidian, CLAUDE.md, etc) — those are construction documentation,
# not Lumos's memory.
LUMOS_TOOL_ALLOWED_PATHS=

# Directory Lumos's write tools save to. Default = data/lumos_notes/ under
# the project root. Lumos can both read AND write here (write root is auto-
# added to the read sandbox).
LUMOS_TOOL_WRITE_PATH=

# Tavily web search API key (https://tavily.com — free tier 1000 searches/mo).
# If unset, web_search falls back to DuckDuckGo via the `ddgs` library.
LUMOS_TAVILY_API_KEY=

# Git workspaces Lumos may operate on. Comma-separated absolute paths.
# Empty = no git access. Lumos can inspect (status/diff/log) and commit/push
# inside these paths; no destructive ops, no force-push, no -A staging.
LUMOS_GIT_WORKSPACES=

LUMOS_CACHE_DIR=./data/cache
LUMOS_HOST=127.0.0.1
LUMOS_PORT=8765
LUMOS_LOG_LEVEL=INFO
LUMOS_LOG_JSON=false

# Local dev can leave this empty when bound to 127.0.0.1. If you bind Lumos
# to 0.0.0.0, LAN, reverse proxy, or public access, set a long random token.
# Send it as Authorization: Bearer <token> or X-Lumos-Token.
LUMOS_API_TOKEN=
LUMOS_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8765,http://127.0.0.1:8765
LUMOS_API_MAX_UPLOAD_BYTES=25000000
LUMOS_API_MAX_IMAGE_DATA_URL_CHARS=14000000
LUMOS_DEBUG_ERRORS=false

# Privileged execution ring. Required for protected actions even on localhost:
# settings mutation, overdrive toggle, dream run/reset, prediction mutation,
# manual autonomous wake tests, and protected voice/macros.
LUMOS_PELE_TOKEN=

# ── GeoSentinel Phase 44 — extra world-sensing sources (all keyless) ──
# Every source below is OFF by default and adds a TOOL Lumos can query on
# demand regardless of these flags. The flags only gate autonomous WAKES.

# GDACS global disaster alerts (floods, cyclones, quakes, volcanoes, wildfires).
# Edge-triggered: one wake per NEW event at/above min level, one more on escalation.
LUMOS_ALERT_GDACS_ENABLED=false
LUMOS_ALERT_GDACS_MIN_LEVEL=orange          # green | orange | red

# NASA FIRMS satellite fire hotspots within radius of the operator (last 24 h).
# Low-confidence pixels never wake; the source cooldown throttles the kind.
LUMOS_ALERT_FIRE_ENABLED=false
LUMOS_ALERT_FIRE_RADIUS_KM=50
LUMOS_ALERT_FIRE_COOLDOWN_MINUTES=180

# ALL satellites overhead (not just recon), identity-enriched (country/launch/type).
# OFF by default — Starlink passes are near-continuous. High elevation cut + a
# source cooldown keep it sane if enabled. Recon birds stay on the recon_satellite kind.
LUMOS_ALERT_SAT_ALL_ENABLED=false
LUMOS_ALERT_SAT_ALL_MIN_ELEVATION_DEG=70
LUMOS_ALERT_SAT_ALL_COOLDOWN_MINUTES=60

# ── Forge Mode (Phase 45) — local coding-agent sessions ──
# `lumos forge "fix X"` plans, edits, runs tests via the allow-listed verify
# runner, reads failures, iterates, and checkpoint-commits — in a git workspace
# only, never pushing. OFF by default. Reuses LUMOS_GIT_WORKSPACES for its rails.
LUMOS_FORGE_ENABLED=false
LUMOS_FORGE_MAX_ITERATIONS=40
# Workspace to work in; empty = first entry in LUMOS_GIT_WORKSPACES.
LUMOS_FORGE_WORKSPACE=
# Brain for Forge; empty = LUMOS_MODEL_HEAVY. (Point at a local coder model here
# once you have one loaded, e.g. qwen/qwen3.5-coder-30b.)
LUMOS_FORGE_MODEL=
LUMOS_FORGE_AUTO_COMMIT=true
LUMOS_FORGE_ALLOW_PUSH=false
# Eject the companion 9B and load LUMOS_FORGE_MODEL for the session, then restore
# the 9B after — so a big coder model + the companion don't fight for VRAM. Only
# acts when LUMOS_FORGE_MODEL differs from LUMOS_MODEL_LIGHT (else a no-op).
LUMOS_FORGE_SWAP_MODEL=true
# Extra allow-listed verify command prefixes (comma-separated). Empty = built-in
# safe set (pytest / ruff / python -m compileall / npm run build|lint|test).
LUMOS_FORGE_VERIFY_COMMANDS=

# ── Self-updating entity memory (Phase 45.3) — the google→RAG loop ──
# Wake names an unknown satellite/vessel/disaster → a background worker (NOT the
# wake) web-searches it, distills it with the local brain, and files it into the
# knowledge lane so the RAG knows it next time. OFF by default. The wake only
# queues (pure code) — the outbound lookup is this separate, gated chore.
LUMOS_ENRICHMENT_ENABLED=false
LUMOS_ENRICHMENT_POLL_INTERVAL_SECONDS=120
LUMOS_ENRICHMENT_DAILY_CAP=30
LUMOS_ENRICHMENT_BATCH_SIZE=3
LUMOS_ENRICHMENT_MAX_QUEUE=200
LUMOS_ENRICHMENT_SKIP_IF_CHAT_ACTIVE_MINUTES=2

# ── Standing Orders (Phase 45.5) — operator-signed proactive recipes ──
# A signed playbook maps wake triggers → whitelisted actions (compile a dossier,
# write a note, stage a briefing, DM you on Discord, file a report into a git
# workspace). Two locks: the HMAC token below + a fixed action whitelist. OFF by
# default; an unsigned or tampered playbook is refused. After editing the
# playbook, run `lumos orders sign` to re-sign it.
LUMOS_STANDING_ORDERS_ENABLED=false
LUMOS_STANDING_ORDERS_PATH=
# Set a strong secret; without it, NO orders run (fail-closed). Then `lumos orders sign`.
LUMOS_STANDING_ORDERS_TOKEN=
LUMOS_STANDING_ORDERS_DAILY_CAP=20
# Schumann ELF (7.83 Hz) amplitude → fills the RHC AtmosphericPressure term the
# flare/quake logs leave null. OPT-IN: no universal keyless API exists (most live
# sources are spectrogram images), so point this at a JSON endpoint you trust
# that returns an amplitude. Empty = term stays honestly null (never faked).
# The _KEY vars are optional — set them if the feed's field names aren't obvious
# (dotted paths allowed, e.g. data.amp). Every logged row is tagged with source.
LUMOS_SCHUMANN_URL=
LUMOS_SCHUMANN_AMP_KEY=
LUMOS_SCHUMANN_FREQ_KEY=

# Autonomous wakes are independent observations, not a conversation. Cap how
# many prior wakes the autonomous session carries so each ping analyses "what's
# overhead now" with FRESH depth instead of copying its own prior answers
# (accumulated wakes act as few-shot examples that collapse the thinking
# turn-over-turn). Continuity comes from RAG retrieval, not replayed history.
# 0 = fully fresh each wake; 1 = carry the previous wake. Chat is unaffected.
LUMOS_AUTONOMOUS_HISTORY_TURNS=1

# IODA internet outages (country-level connectivity blackouts).
# Watch list empty = any country; else comma-separated ISO codes (e.g. GB,IE,FR).
LUMOS_ALERT_OUTAGE_ENABLED=false
LUMOS_ALERT_OUTAGE_MIN_SCORE=50
LUMOS_ALERT_OUTAGE_COUNTRIES=

# ── Regulus eastern gate (upgraded from plain rise, 2026-07-15) ──
# RHC anchor: Sphinx→Regulus az 90.00°E, alt 1–25° (JPL-verified). One wake on
# gate ENTRY (az window), one on 🦁 LION LOCK (due-east crossing inside it).
# LUMOS_ALERT_REGULUS_RISE_ENABLED (above) still gates the whole source.
LUMOS_ALERT_REGULUS_AZ_MIN=85.0
LUMOS_ALERT_REGULUS_AZ_MAX=95.0
LUMOS_ALERT_REGULUS_ALT_MIN=1.0
LUMOS_ALERT_REGULUS_ALT_MAX=25.0
LUMOS_ALERT_REGULUS_LOCK_AZ=90.0


# ── OpenAI / ChatGPT as an Overdrive provider ──────────────────────────────
# Route the Overdrive cloud brain to OpenAI with LUMOS_OVERDRIVE_PROVIDER=openai.
# (Provider also accepts: nvidia, gemini — that line may already exist above;
#  if so, just note openai is now a valid value and skip the duplicate.)
LUMOS_OVERDRIVE_PROVIDER=nvidia
LUMOS_OPENAI_API_KEY=
LUMOS_OPENAI_BASE_URL=https://api.openai.com/v1
LUMOS_OPENAI_MODEL_HEAVY=gpt-5
LUMOS_OPENAI_MODEL_LIGHT=gpt-4o
LUMOS_OPENAI_TEMPERATURE=0.65
LUMOS_OPENAI_TOP_P=0.95
LUMOS_OPENAI_MAX_TOKENS=8192

# ── NeMo Retriever reranker (opt-in retrieval-quality boost) ───────────────
# Reorders retrieval hits via NVIDIA's cross-encoder. Needs LUMOS_NVIDIA_API_KEY.
# Self-disables if the hosted model 4xx's (NVIDIA rotates them); URL empty =
# auto-derive from the model. Always falls back to cosine order on any error.
LUMOS_NVIDIA_RERANK_ENABLED=false
LUMOS_NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
LUMOS_NVIDIA_RERANK_URL=

# ── NVIDIA Magpie TTS (hosted cloud voice) ─────────────────────────────────
# Pick "nvidia" in the HUD voice provider. gRPC Riva endpoint — needs the
# nvidia-riva-client package (uv pip install nvidia-riva-client) + LUMOS_NVIDIA_API_KEY.
# Voices: Magpie-Multilingual.EN-US.{Sofia|Aria|Jason|Leo}.
LUMOS_NVIDIA_TTS_URI=grpc.nvcf.nvidia.com:443
LUMOS_NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
LUMOS_NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Sofia
LUMOS_NVIDIA_TTS_LANGUAGE=en-US
LUMOS_NVIDIA_TTS_SAMPLE_RATE=22050

# ── Obsidian vault-graph (associative third memory) ────────────────────────
# Comma-separated Obsidian vault folder paths. Lumos parses their [[wikilink]]
# graph (no embedding) and traverses it via the vault_* tools. Empty = off.
# Build/inspect with:  lumos vault-graph --rebuild
LUMOS_VAULT_DIRS=

# ── Forge on the Overdrive cloud brain ─────────────────────────────────────
# true → `lumos forge` uses the configured Overdrive provider instead of the
# local coder. Per-run override: lumos forge --overdrive / --local.
LUMOS_FORGE_OVERDRIVE=false

# ── Enrichment web search (optional) ───────────────────────────────────────
# Tavily key makes background enrichment resilient (preferred over SearXNG).
# (May already exist above — skip the duplicate if so.)
LUMOS_TAVILY_API_KEY=